# Build-time regenerator for build_version.h.
#
# Invoked by the pry_build_version custom target on every build so the
# agent/umagent's self-reported PRY_GIT_SHA tracks the current HEAD +
# dirty state — otherwise the SHA is frozen at the last `cmake -S . -B
# build` run and successive `cmake --build` after a branch switch keep
# stamping the stale configure-time SHA onto fresh binaries.
#
# Expected -D vars:
#   PRY_SOURCE_DIR       = repo root (CMAKE_SOURCE_DIR)
#   PRY_BUILD_VERSION_IN = template path (build_version.h.in)
#   PRY_BUILD_VERSION_H  = output path (build/generated/build_version.h)

find_package(Git QUIET)
set(PRY_GIT_SHA "nogit")
set(PRY_GIT_DIRTY "")
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD
        WORKING_DIRECTORY ${PRY_SOURCE_DIR}
        OUTPUT_VARIABLE PRY_GIT_SHA OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    # Scope the dirty check to SOURCE paths that actually feed the C++
    # build — docs drift (images, generated pages, …), local
    # orchestrator run logs, scratch files, etc. shouldn't make the
    # agent self-report as "-dirty". The pathspec below mirrors what's
    # linked into the agent/umagent/driver binaries.
    execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --
            agent umagent driver cmake proto CMakeLists.txt
            orchestrator/src orchestrator/proto
        WORKING_DIRECTORY ${PRY_SOURCE_DIR}
        OUTPUT_VARIABLE _pry_git_dirty OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(_pry_git_dirty)
        set(PRY_GIT_DIRTY "-dirty")
    endif()
endif()

# Only overwrite the output when the stamp actually changed — otherwise
# every build touches the header and forces a full recompile of every
# TU that includes it.
set(_new_contents
"#pragma once\n// generated by refresh_build_version.cmake — do not edit\n#define PRY_GIT_SHA \"${PRY_GIT_SHA}\"\n#define PRY_GIT_DIRTY \"${PRY_GIT_DIRTY}\"\n")

set(_old_contents "")
if(EXISTS ${PRY_BUILD_VERSION_H})
    file(READ ${PRY_BUILD_VERSION_H} _old_contents)
endif()

if(NOT "${_new_contents}" STREQUAL "${_old_contents}")
    file(WRITE ${PRY_BUILD_VERSION_H} "${_new_contents}")
    message(STATUS "pry: build_version.h -> ${PRY_GIT_SHA}${PRY_GIT_DIRTY}")
endif()
